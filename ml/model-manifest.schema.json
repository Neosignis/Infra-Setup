{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Neosignis model promotion manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "sha256", "language", "input_schema", "preprocessing_version", "scope", "rights_record_ids", "training_dataset_versions", "evaluation_report_id", "calibration_status", "hardware_profile", "approved_by", "status"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "language": {"enum": ["ase", "nsi"]},
    "input_schema": {"type": "string", "minLength": 1},
    "preprocessing_version": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "rights_record_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "training_dataset_versions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evaluation_report_id": {"type": "string", "minLength": 1},
    "calibration_status": {"enum": ["uncalibrated", "validated_for_scope"]},
    "hardware_profile": {"type": "object", "required": ["device", "memory_mib", "p95_ms"], "properties": {"device": {"type": "string"}, "memory_mib": {"type": "integer", "minimum": 1}, "p95_ms": {"type": "number", "minimum": 0}}},
    "approved_by": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["candidate", "internal_demo", "pilot", "production", "withdrawn"]}
  }
}
