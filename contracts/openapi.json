          "languages": {
            "items": {
              "$ref": "#/components/schemas/Capability"
            },
            "title": "Languages",
            "type": "array"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "languages"
        ],
        "title": "Capabilities",
        "type": "object"
      },
      "Capability": {
        "additionalProperties": false,
        "properties": {
          "approved": {
            "default": false,
            "title": "Approved",
            "type": "boolean"
          },
          "language": {
            "$ref": "#/components/schemas/Language"
          },
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Version"
          },
          "recognize": {
            "default": false,
            "title": "Recognize",
            "type": "boolean"
          },
          "render": {
            "default": false,
            "title": "Render",
            "type": "boolean"
          },
          "scope": {
            "default": "unavailable",
            "title": "Scope",
            "type": "string"
          }
        },
        "required": [
          "language"
        ],
        "title": "Capability",
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
