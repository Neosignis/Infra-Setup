              },
              {
                "type": "null"
              }
            ],
            "title": "Asset Id"
          },
          "language": {
            "$ref": "#/components/schemas/Language"
          },
          "output_kind": {
            "anyOf": [
              {
                "enum": [
                  "recorded_signer",
                  "rigged_avatar",
                  "neural_human"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Kind"
          },
          "reason": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "renderer_version": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Renderer Version",
            "type": "string"
          },
          "signer_id": {
            "title": "Signer Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "ready",
              "unsupported"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "language",
          "signer_id",
          "renderer_version",
          "status"
        ],
        "title": "RenderResult",
        "type": "object"
      }
