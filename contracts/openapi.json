            "title": "Face"
          },
          "left_hand": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Point"
                },
                "maxItems": 21,
                "minItems": 21,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Left Hand"
          },
          "pose": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Point"
                },
                "maxItems": 33,
                "minItems": 33,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pose"
          },
          "right_hand": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Point"
                },
                "maxItems": 21,
                "minItems": 21,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Right Hand"
          },
          "t_ms": {
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "T Ms",
            "type": "integer"
          }
        },
        "required": [
          "t_ms"
        ],
        "title": "Frame",
        "type": "object"
      },
      "Language": {
        "enum": [
          "ase",
          "nsi"
        ],
        "title": "Language",
        "type": "string"
      },
