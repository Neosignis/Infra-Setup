        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Frame": {
        "additionalProperties": false,
        "properties": {
          "face": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Point"
                },
                "maxItems": 478,
                "minItems": 478,
                "type": "array"
              },
              {
                "type": "null"
              }
