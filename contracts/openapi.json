        "required": [
          "feature_schema",
          "extractor_version",
          "mirrored",
          "frames"
        ],
        "title": "RecognizeRequest",
        "type": "object"
      },
      "RecognizeResult": {
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
